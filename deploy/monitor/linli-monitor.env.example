# deploy/monitor/linli-monitor.env.example
# 落盘：/etc/linli-monitor.env（权限 600，内含 webhook 密钥）
#
# WEBHOOK_URL 留空时脚本照常运行，只把异常写进 journal；填入后立即开始推送，
# 无需重启 timer（每次执行都会重新读取本文件）。
#
# 群机器人地址示例（把 key 换成你自己的）：
#   企业微信  https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxx
#   钉钉      https://oapi.dingtalk.com/robot/send?access_token=xxxx
#   飞书      https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
#
# 注意：
#   · 钉钉机器人若开启「自定义关键词」，请把关键词设为「暖阳邻里」，本脚本消息固定以此开头。
#   · 飞书用 msg_type / content.text 结构，务必把 WEBHOOK_TYPE 改成 feishu。

WEBHOOK_URL=
WEBHOOK_TYPE=wecom

# 站点域名：证书路径与 Host 头都用它，改域名时只改这里
SITE_HOST=linli.lzbdcxm.cn

# 根分区使用率阈值（百分比）
DISK_MAX=85

# 证书剩余天数阈值
CERT_MIN_DAYS=14
